<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 版本号单一来源：写入程序集信息版本（关于行与打包文件命名均由此读取） -->
    <Version>0.1.0</Version>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</PublishAot>
    <!-- Windows 固定 win-x64，以便 TlsClient.Native.win-x64 的 targets 拷贝 tls-client.dll -->
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GlaccAuto.Core\GlaccAuto.Core.csproj" />
  </ItemGroup>
  <!-- 发布时把 TLS 指纹库放到 publish 根目录（GlaccTls 探针覆盖 exe 同目录） -->
  <Target Name="CopyTlsClientToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_TlsNative Include="$(OutputPath)runtimes\tls-client\**\tls-client.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TlsNative)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_TlsNative)' != ''" />
  </Target>
</Project>
