<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <AssemblyName>glacc-auto</AssemblyName>
    <RootNamespace>GlaccAuto.Cli</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GlaccAuto.Core\GlaccAuto.Core.csproj" />
  </ItemGroup>
  <!-- 发布时把 TLS 指纹库拷到 publish 根目录，便于不带 runtimes 子树也能跑 -->
  <Target Name="CopyTlsClientToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_TlsNative Include="$(OutputPath)runtimes\tls-client\**\tls-client.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TlsNative)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_TlsNative)' != ''" />
  </Target>
</Project>
